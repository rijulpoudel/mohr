DJANGO_PRODUCTION=False
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=mohr
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DATABASE_URL belongs in provider/local environment settings, not here.
# Leave blank for local component-based POSTGRES_* configuration.
# Only required when DJANGO_PRODUCTION=True or to exercise a URL before production.
DATABASE_URL=

# --- Plaid Sandbox (v0.2, docs/plaid.md sections 2 and 4) ----------------
# Leave PLAID_ENABLED blank (False) unless a complete Sandbox configuration
# is present. When enabled, startup fails unless PLAID_ENV is exactly
# "sandbox", PLAID_CLIENT_ID and PLAID_SECRET are non-empty (whitespace-only
# values are rejected, exact non-empty values are used as-is), and
# PLAID_TOKEN_KEYS is a valid ordered key ring. No Production Plaid access
# is supported in v0.2.
#
# PLAID_TOKEN_KEYS syntax: comma-separated keyid:key pairs, first entry is
# the primary key used for all new encryption. Example shape:
#   PLAID_TOKEN_KEYS=keyid1:<Fernet key>,keyid2:<Fernet key>
# keyid: an opaque stable label of 1-64 characters whose first character is
# alphanumeric ([A-Za-z0-9]) and whose remaining characters are in
# [A-Za-z0-9._-], never derived from key material and never a list position.
# key: a Fernet key, generated with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: deploy the new key as the first entry (new primary) while
# keeping old keys listed until every stored token is re-encrypted; only
# then remove a superseded key from the ring.
PLAID_ENABLED=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TOKEN_KEYS=
